:root {
  --sky: #0f172a;
  --panel: rgba(15, 23, 42, 0.8);
  --panel-soft: rgba(30, 41, 59, 0.8);
  --gold: #fbbf24;
  --green: #34d399;
  --red: #f87171;
  --text: #e2e8f0;
  --shadow: rgba(15, 23, 42, 0.45);
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

body {
  display: flex;
  justify-content: center;
  padding: 16px;
}

.app-shell {
  width: min(100%, 480px);
  background: var(--panel);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  box-shadow: 0 24px 50px var(--shadow);
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 8px;
}

.title-block {
  min-width: 0;
}

.eyebrow {
  margin: 0;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
}

h1 {
  margin: 5px 0 0;
  font-size: clamp(1.5rem, 4vw, 2.1rem);
  line-height: 1.1;
}

.secondary-btn,
.install-btn,
button[data-dir] {
  touch-action: manipulation;
}

.secondary-btn,
.install-btn {
  border: none;
  border-radius: 999px;
  font-weight: 700;
  padding: 10px 14px;
}

.secondary-btn {
  background: rgba(148, 163, 184, 0.15);
  color: white;
}

.install-btn {
  margin: 0 auto 16px;
  background: linear-gradient(135deg, var(--green), #14b8a6);
  color: #052e2a;
  display: block;
  width: calc(100% - 32px);
}

.install-btn.hidden {
  display: none;
}

.hud {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  padding: 0 18px 12px;
}

.stat,
.mission-bar {
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 14px;
}

.stat {
  text-align: center;
  padding: 10px 8px;
}

.label,
.mission-label {
  display: block;
  margin-bottom: 4px;
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.8;
}

.stat strong {
  display: block;
  font-size: 1.2rem;
}

.mission-bar {
  margin: 0 18px 14px;
  padding: 10px 14px;
  line-height: 1.4;
}

#missionText {
  font-size: 0.9rem;
}

canvas {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  background: linear-gradient(180deg, #0f766e 0%, #14532d 100%);
  border-top: 1px solid rgba(148, 163, 184, 0.15);
  border-bottom: 1px solid rgba(148, 163, 184, 0.15);
}

.controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 14px 18px 8px;
}

.control-row {
  display: flex;
  justify-content: center;
}

.control-row.middle {
  gap: 18px;
}

button[data-dir] {
  width: 62px;
  height: 62px;
  border: none;
  border-radius: 16px;
  background: rgba(148, 163, 184, 0.14);
  color: white;
  font-size: 1.9rem;
  font-weight: 700;
}

.message {
  min-height: 48px;
  padding: 8px 18px 18px;
  text-align: center;
  line-height: 1.5;
  color: #dbeafe;
}

@media (max-width: 420px) {
  body {
    padding: 0;
  }

  .app-shell {
    width: 100%;
    min-height: 100vh;
    border-radius: 0;
  }
}
